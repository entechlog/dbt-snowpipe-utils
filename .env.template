# =============================================================================
# PROJECT ENVIRONMENT VARIABLES
# =============================================================================
export ENV_CODE=<environment-code>              # dev, stg, prd
export PROJ_CODE=<project-code>                 # Your project identifier
export SNOWSQL_ACCOUNT=<snowflake-account>      # Your Snowflake account identifier
export SNOWSQL_PWD=<snowflake-password>         # Service account password

# =============================================================================
# SNOWPIPE PACKAGE ENVIRONMENT VARIABLES
# =============================================================================

# Core Snowflake Configuration (Required)
export SNOWPIPE_DATABASE="<database-name>"      # Target database for pipes and tables
export SNOWPIPE_SCHEMA="<schema-name>"          # Schema containing stages and file formats
export SNOWPIPE_WAREHOUSE="<warehouse-name>"    # Warehouse for pipe operations

# Role Configuration (Required)
export SNOWPIPE_ADMIN_ROLE="<admin-role>"       # Role with CREATE PIPE privileges
export SNOWPIPE_MONITOR_ROLES="<role1,role2>"   # Comma-separated roles for monitoring

# Stage Names (Optional - uses defaults if not set)
export SNOWPIPE_JSON_STAGE="<json-stage-name>"     # Stage for JSON files
export SNOWPIPE_PARQUET_STAGE="<parquet-stage>"    # Stage for Parquet files  
export SNOWPIPE_CSV_STAGE="<csv-stage-name>"       # Stage for CSV files

# File Format Names (Optional - uses defaults if not set)
export SNOWPIPE_JSON_FORMAT="<json-format>"        # JSON file format name
export SNOWPIPE_PARQUET_FORMAT="<parquet-format>"  # Parquet file format name
export SNOWPIPE_CSV_FORMAT="<csv-format>"          # CSV file format name

# Snowflake Integration Settings (Optional)
export SNOWPIPE_ENABLE_ERROR_INTEGRATION=<true/false>     # Enable error notifications
export SNOWPIPE_ERROR_INTEGRATION="<integration-name>"    # Error notification integration

# Seed Schema Override (Optional)
export SNOWPIPE_SEED_SCHEMA="<seed-schema>"        # Schema for configuration seed table